# /opt/property-search/.env on the VM (chmod 600, owned by propsearch).
# bootstrap.sh generates this with a random secret key and DB password; the
# two hostnames below are filled in once Tailscale and Vercel are set up.

DJANGO_SECRET_KEY=<generated>
DJANGO_DEBUG=False

# The Funnel hostname, e.g. propsearch-vm.tail1234.ts.net
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,<vm>.<tailnet>.ts.net
DJANGO_CSRF_TRUSTED_ORIGINS=https://<vm>.<tailnet>.ts.net
DJANGO_BEHIND_HTTPS_PROXY=True

# The Vercel production URL; the regex also admits preview deployments.
DJANGO_CORS_ALLOWED_ORIGINS=https://<project>.vercel.app
DJANGO_CORS_ALLOWED_ORIGIN_REGEXES=^https://<project>-.*\.vercel\.app$

DATABASE_URL=postgresql://property_search:<generated>@localhost:5432/property_search
