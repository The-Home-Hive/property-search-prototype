# Copy to .env and fill in — never commit the real .env

# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Origins allowed to call the API in dev (Vite's default port)
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173
# Production only — see deploy/README.md
# DJANGO_CORS_ALLOWED_ORIGIN_REGEXES=^https://<project>-.*\.vercel\.app$
# DJANGO_CSRF_TRUSTED_ORIGINS=https://<vm>.<tailnet>.ts.net
# DJANGO_BEHIND_HTTPS_PROXY=True

# PostgreSQL — full connection string, e.g.
# postgresql://user:password@host:5432/dbname (add ?sslmode=require for hosted providers like Neon)
DATABASE_URL=postgresql://property_search:change-me@localhost:5432/property_search

# Frontend
VITE_API_BASE_URL=http://localhost:8000
