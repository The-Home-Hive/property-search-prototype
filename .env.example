# Copy to .env and fill in — never commit the real .env

# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database — parsed by dj-database-url, so it's a single URL, not split parts.
# Postgres:  postgres://USER:PASSWORD@HOST:PORT/NAME
DATABASE_URL=postgres://property_search:change-me@localhost:5432/property_search

# Comma-separated origins allowed to call the API. Vite's dev server is :5173.
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173

# Frontend
VITE_API_BASE_URL=http://localhost:8000
